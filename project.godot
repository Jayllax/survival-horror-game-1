; Ignotum — open this file with Godot 4.4 or later.
config_version=5

[application]
config/name="Ignotum"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://art/icon.svg"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[autoload]
Game="*res://scripts/game.gd"
Transition="*res://scenes/ui/transition.tscn"

[gui]
theme/custom="res://art/ui_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)

2d/snap/snap_2d_transforms_to_pixel=true

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
melee={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":73)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
