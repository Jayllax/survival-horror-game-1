[sub_resource type="Resource" id="Resource_qayus"]
script = ExtResource("16_kwcdv")
title = "Bloody note"
text = "Good job finding the key, fuck face. That was the point. So you know I'm here. And that I know it was you who changed the code to my drawer, you stupid piece of shit. I'll have my revenge, and I don't need my gun to do it. You'll see."

