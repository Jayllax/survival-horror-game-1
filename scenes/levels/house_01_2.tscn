[sub_resource type="Resource" id="Resource_2kgsg"]
script = ExtResource("15_c6hel")
title = "Note written by a Rasmus"
text = "I don't understand why you would ever want to be in this town. It's so dark and cold. The light isn't out of reach, you just need to find it. Try. Please.

- Rasmus"

[sub_resource type="Resource" id="Resource_c6hel"]
script = ExtResource("15_c6hel")
title = "Angrily written note"
text = "Why has someone changed the fucking code? We all knew it, it worked, why? I don't get it. Change it back!"

