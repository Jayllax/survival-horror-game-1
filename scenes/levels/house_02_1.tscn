[sub_resource type="Resource" id="Resource_l2fto"]
script = ExtResource("36_vncwt")
title = "Manically written note"
text = "I have to write my thoughts down. All these horrible thoughts. My own mind is killing me. I don't know what the fuck is wrong with me but I can't take it much longer. I feel like I'm going insane. I've tried and tried and tried and tried again and again and again to figure out why I'm here. How to escape. But I can't. There's no point to any of this. I'm just stuck in an empty eternal darkness. I don't want to give up but I'm not getting anywhere. What can I do? What the fuck can I do? I need a break. Rest. I need to rest."

