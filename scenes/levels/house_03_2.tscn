[sub_resource type="Resource" id="Resource_1402q"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("20_xe5ls")
text = "I don't know, man, but I don't want to stick around too long. That's for sure."
choices = Array[ExtResource("18_xe5ls")]([SubResource("Resource_at73x"), SubResource("Resource_fdp1k")])
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_urshd"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Oh by the way, do the numbers 1503 mean anything to you?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_6l5d1"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "No, I don't think so. Why?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_qi71t"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Those numbers just keep repeating in my head for some reason. This place sure is strange."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_4ry7p"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "Yeah... well, I'll keep them in mind. Maybe they're important."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_3yrhw"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Yeah maybe. Let me know if you find out anything."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_j2x64"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "Sure, I will. But uhm, I'm gonna go back to finding a way out of here, you coming with?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_yxqjj"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Nah, I'm gonna stay here for a while. I have this strange feeling that I need to."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_xligd"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "Alright, can't argue with strange feelings. "
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_0ujvr"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Hah, yeah. Take care of yourself, someone. See you around."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_lfg3a"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "You too, see ya."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

