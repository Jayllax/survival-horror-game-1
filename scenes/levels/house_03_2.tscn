[sub_resource type="Resource" id="Resource_28k42"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "Hey, øhh, undskyld, v-ved du, hvor vi er henne?"

[sub_resource type="Resource" id="Resource_yhxjy"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("20_xe5ls")
text = "Come again?"

[sub_resource type="Resource" id="Resource_r3hm7"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "Oh, sorry, uhm, I thought we were in... nevermind. I'm really confused, do you know where we are?"

[sub_resource type="Resource" id="Resource_ujyqf"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("20_xe5ls")
text = "No idea. I just woke up in a forest outside of town with no recollection of how I got there. I thought I was the only one here until now."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_rg7w5"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "So did I... what the fuck is this place?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_uvfgb"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "Do you also not remember your name?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_kxjmj"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("20_xe5ls")
text = "No, I remember, it's Jax. Jax Dole. You don't?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_07xaa"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "No... I-I don't. But uhm, nice to meet you Jax. I'm... well, someone."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_36lin"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("19_ujyqf")
text = "You haven't found any way out of this place, have you?"
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_0p0gy"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Nah, seems like everything's fenced off or locked, so I decided to chill here for a while."
metadata/_custom_type_script = "uid://dokxahjw0ajyo"

[sub_resource type="Resource" id="Resource_d2p6s"]
script = ExtResource("22_1402q")
lines = Array[ExtResource("17_ujyqf")]([SubResource("Resource_36lin"), SubResource("Resource_0p0gy")])
metadata/_custom_type_script = "uid://n78cmm0wplag"

[sub_resource type="Resource" id="Resource_rpcjx"]
script = ExtResource("18_xe5ls")
text = "Ask for his help getting out of town."
next_dialogue = SubResource("Resource_d2p6s")
metadata/_custom_type_script = "uid://c72jybcn230jo"

[sub_resource type="Resource" id="Resource_1fmwm"]
script = ExtResource("17_ujyqf")
speaker = ExtResource("21_ujyqf")
text = "Hah. Nice to meet you too, someone."
